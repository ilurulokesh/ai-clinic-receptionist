# Environment Variables Reference

Copy this file to `.env` and fill in your values.
**Never commit your actual `.env` file — it is gitignored.**

# ─── Google Calendar ──────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=your-doctor@gmail.com
# The Google OAuth2 credential is configured directly inside n8n, not here.

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Consultation fee in paise (e.g. 50000 = ₹500)
CONSULTATION_FEE_PAISE=50000

# ─── WhatsApp Business API ───────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_TOKEN=your_meta_system_user_access_token
WHATSAPP_TEMPLATE_NAME=clinic_booking_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=te

# ─── MSG91 (SMS) ──────────────────────────────────────────────────────────────
MSG91_AUTHKEY=your_msg91_authkey
MSG91_TEMPLATE_ID=your_msg91_flow_template_id
MSG91_SENDER_ID=CLINIC

# ─── Clinic Settings ─────────────────────────────────────────────────────────
CLINIC_NAME=Dr. Rao's Clinic
CLINIC_OPENING_HOUR=9
CLINIC_CLOSING_HOUR=18
APPOINTMENT_DURATION_MINUTES=30

# ─── Tough Tongue AI ─────────────────────────────────────────────────────────
# Set these in Tough Tongue AI's dashboard directly — not needed here.
# Included for reference:
# TOUGH_TONGUE_WEBHOOK_A = <n8n Workflow A webhook URL>
# TOUGH_TONGUE_WEBHOOK_B = <n8n Workflow B webhook URL>
